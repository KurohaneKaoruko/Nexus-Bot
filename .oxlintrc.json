{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"sim/",
		"dist/",
		"scripts/",
		"plugins/"
	],
	"globals": {
		"__dirname": "readonly"
	},
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"unicorn/no-array-sort": "off",
		"unicorn/consistent-function-scoping": "off",
		"eslint/no-underscore-dangle": [
			"error",
			{
				"allow": [
					"__carryTrace",
					"__dropped",
					"__layoutPlannerCache",
					"__moveWorkTileRuntimeIntent",
					"_assign",
					"_atk_damage",
					"_attackTargets",
					"_attackable_creeps",
					"_attackable_structures",
					"_been_heal",
					"_break_damage",
					"_deliverTarget",
					"_fetchSrc",
					"_fired_damage",
					"_heal_need",
					"_heal_power",
					"_idObjCache",
					"_idObjCacheTime",
					"_init",
					"_ism",
					"_ismNonce",
					"_ismToShard",
					"_loadLineId",
					"_lpt",
					"_lpv",
					"_moveToRoomState",
					"_need_heal_power",
					"_nukeDemandCache",
					"_ops",
					"_ra_atk_enemys",
					"_ra_damage",
					"_ra_enemys",
					"_relayed",
					"_resAllMap",
					"_resAllTime",
					"_roomName",
					"_roomTickCache",
					"_spawnMissionNumCache",
					"_spawnMissionNumCacheTick",
					"_targets",
					"_teamOrderTick",
					"_team_hostiles",
					"_team_hostiles_ranged",
					"_team_hostiles_rangedOrAttack",
					"_team_hostiles_tick",
					"_toward",
					"_transfered",
					"_virtual_damage",
					"_virtual_hits",
					"_wallMissionTickCacheTask",
					"_wallMissionTickCacheTick"
				],
				"allowAfterThis": true
			}
		]
	},
	"overrides": [
		{
			"files": ["rolldown.config.js"],
			"rules": {
				"eslint/no-underscore-dangle": "off"
			}
		},
		{
			"files": ["src/branch/compat.ts"],
			"rules": {
				"typescript/no-extraneous-class": "off"
			}
		}
	]
}
